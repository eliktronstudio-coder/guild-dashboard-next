// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String     @id @default(cuid())
  username        String     @unique
  passwordHash    String
  role            String     @default("random")
  createdAt       DateTime   @default(now())
  player          Player?
  addedActivities Activity[]
}

model Player {
  id                  String                @id @default(cuid())
  name                String
  role                String
  level               Int                   @default(1)
  xp                  Int                   @default(0)
  attendancePct       Int                   @default(0)
  salaryCoefficient   Float                 @default(1)
  createdAt           DateTime              @default(now())
  activities          ActivityParticipant[]
  userId              String?               @unique
  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments            Payment[]
  drops               DropItem[]
  archiveStats        ArchivePlayerStat[]
  auctionBids         AuctionBid[]
  organizedActivities Activity[]            @relation("ActivityOrganizer")
  ledActivities       Activity[]            @relation("ActivityRaidLeader")
}

model Activity {
  id                 String                @id @default(cuid())
  name               String
  category           String                @default("Мини-РБ")
  mode               String                @default("PvE")
  difficulty         String                @default("Обычная")
  status             String                @default("К выплате")
  isNight            Boolean               @default(false)
  perAttendanceValue Int                   @default(0)
  /// Коэффициент для расчёта посещаемости Прайма (0.5 для лёгкого контента,
  /// 1.5 для разъярённых боссов и т.д.) — при создании подставляется по
  /// названию (см. activityAttendanceWeight в src/lib/activityWeights.ts),
  /// дальше админ может поправить вручную под конкретную активность.
  weight             Float                 @default(1)
  addedByUserId      String?
  addedBy            User?                 @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)
  periodId           String?
  period             AccountingPeriod?     @relation(fields: [periodId], references: [id], onDelete: SetNull)
  /// Ручная архивация за выбранный диапазон дат (раздел «Экономика → Архив»).
  /// Архивные активности не показываются на /activities и не считаются в
  /// живой посещаемости — но данные не удаляются, только помечаются.
  archiveId          String?
  archive            Archive?              @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  date               DateTime              @default(now())
  createdAt          DateTime              @default(now())
  participants       ActivityParticipant[]
  drops              DropItem[]
  screenshots        ActivityScreenshot[]
  guests             ActivityGuest[]

  /// Ключ босса из BOSS_ALIASES (src/lib/achievements/catalog.ts), null — не
  /// боссовая активность. Хранится ключом, а не именем: имена дублируются
  /// («Левиафан» / «Разъярённый Левиафан»), а ключ один на группу алиасов.
  bossKey            String?
  /// Подтверждает ГМ/РЛ вручную: факт участия в рейде не значит, что босс
  /// убит — это ровно то смешение, которое запрещено достижениями.
  bossKillConfirmed  Boolean @default(false)
  /// Сколько убийств засчитывается этой записью. Один рейд — одно посещение,
  /// но может дать несколько убийств (актуально для мини-РБ).
  killCount          Int     @default(1)
  /// Победа | Поражение | null — не указан. Участие само по себе победой
  /// не является.
  pvpResult          String?
  /// Отмечает гильдейский PvP-рейд отдельно от обычного PvP.
  pvpGuildRaid       Boolean @default(false)
  /// Отмечает событие защиты гильдии.
  guildDefense       Boolean @default(false)
  organizerPlayerId  String?
  organizer          Player? @relation("ActivityOrganizer", fields: [organizerPlayerId], references: [id], onDelete: SetNull)
  raidLeaderPlayerId String?
  raidLeader         Player? @relation("ActivityRaidLeader", fields: [raidLeaderPlayerId], references: [id], onDelete: SetNull)

  @@index([archiveId])
  @@index([periodId])
  @@index([bossKey])
  @@index([organizerPlayerId])
  @@index([raidLeaderPlayerId])
}

model ActivityGuest {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
}

model ActivityScreenshot {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  kind       String
  imageUrl   String
  createdAt  DateTime @default(now())
}

model ActivityParticipant {
  id         String   @id @default(cuid())
  activityId String
  playerId   String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// Отмечается вручную, отдельно от факта посещения: досидел до конца
  /// рейда, а не просто зашёл и вышел.
  fullParticipation Boolean @default(false)

  @@unique([activityId, playerId])
}

model TreasuryTransaction {
  id          String            @id @default(cuid())
  description String
  amount      Int
  /// Категория операции, когда к ней не привязан дроп («Мини-РБ»).
  /// Обычные продажи дропа категорию не задают — она берётся из проданных
  /// позиций, см. getTreasurySplitByCategory в src/lib/queries.ts.
  category    String?
  /// "payout" — расход на выплату ЗП (см. /api/payments/payout). Такие
  /// операции считаются отдельно от дохода (getTreasuryPayoutSplit) и
  /// вычитаются из prime/miniRb 1:1, минуя 70%-й множитель фонда ЗП —
  /// иначе выплата X золота уменьшала бы «Казну с Прайма» лишь на 0.7X,
  /// а остаток разницы ошибочно списывался бы с резерва гильдии.
  kind        String?
  /// Расчётный период (15→15), к которому относится операция. Null у
  /// операций, созданных до введения периодов — они остаются "бесхозными"
  /// и не мешают уже архивированным/текущему периоду.
  periodId    String?
  period      AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  /// Ручная архивация (см. Activity.archiveId) — архивные операции не
  /// участвуют в живом балансе казны (getTreasuryBreakdown и т.д.), только
  /// хранятся для просмотра в разделе «Архив».
  archiveId   String?
  archive     Archive?          @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  date        DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([periodId])
  @@index([archiveId])
}

/// Ручная архивация за произвольный диапазон дат (раздел «Экономика → Архив»,
/// кнопка «Архив периода»). В отличие от AccountingPeriod (авто-цикл 15→15,
/// влияет только на посещаемость), архивация здесь бьёт по живому балансу
/// казны: заархивированные TreasuryTransaction/Activity помечаются, а не
/// удаляются, и живые расчёты их просто больше не считают — баланс на
/// сайте показывает 0 и копится заново, история остаётся доступна в архиве.
model Archive {
  id        String   @id @default(cuid())
  dateFrom  DateTime
  dateTo    DateTime
  /// "01.09.2026 — 15.09.2026" — человекочитаемая метка.
  label     String
  createdAt DateTime @default(now())
  createdBy String?

  transactions TreasuryTransaction[]
  activities   Activity[]
  playerStats  ArchivePlayerStat[]
}

/// Снимок состава на момент архивации: кто был в гильдии и с каким процентом
/// посещаемости. Именно снимок, а не расчёт на лету: посещаемость считается от
/// списка участников (ActivityParticipant), а он каскадно удаляется вместе с
/// игроком — то есть стоит убрать человека из состава, и он бесследно исчез бы
/// из уже закрытого архива вместе со своими процентами. Архив обязан оставаться
/// неизменным, поэтому цифры фиксируются в момент создания архива.
/// playerId держим с onDelete: SetNull — ссылка на живого игрока пропадёт,
/// а имя, роль и проценты в строке останутся.
model ArchivePlayerStat {
  id                  String  @id @default(cuid())
  archiveId           String
  archive             Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  playerId            String?
  player              Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  /// Имя и роль на момент архивации — переименование игрока не должно
  /// задним числом переписывать историю.
  playerName          String
  role                String
  attendancePct       Int
  attendancePctPrime  Int
  attendancePctMiniRb Int
  pvpCount            Int     @default(0)
  /// Доля зарплаты за этот период, зафиксированная в момент архивации.
  /// Считается от казны, какой она была ДО архивации (после неё живая казна
  /// обнуляется), тем же кодом, что и живая зарплата — src/lib/salary.ts.
  salaryPrime         Int     @default(0)
  salaryMiniRb        Int     @default(0)
  /// «Был на N из M» — счётчики, чтобы процент можно было проверить глазами.
  attended            Int     @default(0)
  activitiesTotal     Int     @default(0)

  @@unique([archiveId, playerName])
  @@index([archiveId])
  @@index([playerId])
}

/// Расчётный период гильдии: с 15-го числа одного месяца по 15-е следующего.
/// Ровно один период имеет status="active" в любой момент времени —
/// getActivePeriod() из src/lib/period.ts автоматически закрывает истёкший
/// период и открывает следующий по факту даты, без ручного действия и без
/// архивной задолженности — посещаемость просто начинает считаться заново.
model AccountingPeriod {
  id        String    @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  /// "15.09.2026 — 15.10.2026" — человекочитаемая метка, показывается в UI.
  label     String
  status    String    @default("active")
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())

  transactions TreasuryTransaction[]
  activities   Activity[]
  payments     Payment[]

  @@index([status])
}

model DropCatalogItem {
  id        String     @id @default(cuid())
  name      String     @unique
  imageUrl  String?
  price     Int
  createdAt DateTime   @default(now())
  drops     DropItem[]
  auctions  Auction[]
}

model DropItem {
  id                    String           @id @default(cuid())
  item                  String
  quantity              Int              @default(1)
  value                 Int
  status                String           @default("Не продано")
  warehouse             String           @default("Общий")
  category              String?
  treasuryTransactionId String?
  date                  DateTime         @default(now())
  createdAt             DateTime         @default(now())
  activityId            String?
  activity              Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  playerId              String?
  player                Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)
  catalogItemId         String?
  catalogItem           DropCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
}

model Payment {
  id           String            @id @default(cuid())
  playerId     String
  player       Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amount       Int
  status       String            @default("Ожидает")
  date         DateTime          @default(now())
  source       String            @default("manual")
  archiveMonth String?
  /// "Прайм" | "Мини-РБ" — заполняется у выплат с /api/payments/payout
  /// (кнопки статуса в строке «Расчёт распределения»). У ручных и архивных
  /// записей остаётся null: они покрывают всю зарплату целиком.
  category     String?
  /// Расчётный период (15→15), в который произведена выплата.
  periodId     String?
  period       AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([periodId])
}

/// Оформление одной страницы. pageKey берётся из реестра (src/lib/design/registry.ts);
/// служебный ключ "__shared__" хранит общие элементы и тему.
/// draftJson — черновик администратора, publishedJson — то, что видят посетители.
/// Разделение на две колонки даёт изоляцию: публикация одной страницы не трогает
/// черновики остальных, потому что у каждой страницы своя строка.
model PageDesign {
  id             String          @id @default(cuid())
  pageKey        String          @unique
  draftJson      String          @default("{}")
  publishedJson  String          @default("{}")
  /// Версия формата конфига — чтобы мигрировать сохранённое при смене схемы.
  schemaVersion  Int             @default(1)
  /// Растёт при каждой публикации. Клиент присылает известное ему значение,
  /// и публикация отклоняется, если другой админ успел опубликовать раньше.
  revision       Int             @default(0)
  draftUpdatedAt DateTime        @default(now()) @updatedAt
  draftUpdatedBy String?
  publishedAt    DateTime?
  publishedBy    String?
  versions       DesignVersion[]
}

/// Медиатека редактора оформления. Файл лежит в БД как data:-URL — так же,
/// как баннеры активностей; наружу отдаётся через /api/design/media/[id]/file
/// обычными байтами, чтобы не попадать в hydration-payload страницы.
model DesignMedia {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  dataUrl   String
  createdAt DateTime @default(now())
  createdBy String?

  @@index([createdAt])
}

/// Сохранённый блок для повторного использования: дерево блоков вместе с их
/// оформлением. При вставке идентификаторы пересоздаются, поэтому одну
/// заготовку можно положить на несколько страниц независимо.
model DesignSnippet {
  id        String   @id @default(cuid())
  name      String
  /// JSON: { block: DesignBlock, styles: Record<elementId, ElementValues> }
  payload   String
  createdAt DateTime @default(now())
  createdBy String?

  @@index([createdAt])
}

/// История опубликованных версий оформления: отдельная на каждую страницу,
/// поэтому восстановление одной страницы не откатывает остальные.
model DesignVersion {
  id           String     @id @default(cuid())
  pageDesignId String
  pageDesign   PageDesign @relation(fields: [pageDesignId], references: [id], onDelete: Cascade)
  configJson   String
  note         String     @default("")
  authorName   String     @default("")
  createdAt    DateTime   @default(now())

  @@index([pageDesignId, createdAt])
}

/// Баннер активности: название -> фото. Отдельно от Activity, потому что
/// активностей с одним названием много, а картинка у них общая.
model ActivityBanner {
  id        String   @id @default(cuid())
  name      String   @unique
  imageUrl  String
  /// true, если imageUrl — data:video/... (не грузим тело картинки только
  /// чтобы понять, <video> рендерить или <img>).
  isVideo   Boolean  @default(false)
  /// Размер баннера на странице активности: высота в px, ширина в % от карточки.
  /// height = null — баннер подстраивается под пропорции картинки и показывает её целиком.
  height    Int?
  widthPct  Int?
  /// Собственные размеры картинки — нужны, чтобы посчитать пропорции без её загрузки.
  imgWidth  Int?
  imgHeight Int?
  createdAt DateTime @default(now())
}

/// Живые торги: состояние лежит в базе, а не в браузере ведущего, поэтому
/// участники ставят со своих устройств и все видят одно и то же. Активный
/// аукцион в каждый момент ровно один (status="active").
model Auction {
  id                String           @id @default(cuid())
  /// "active" — торги идут, "finished" — завершены, лидер стал победителем.
  status            String           @default("active")
  itemName          String
  itemImageUrl      String?
  catalogItemId     String?
  catalogItem       DropCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  startingBid       Int
  step              Int
  /// Текущая цена. Служит и признаком гонки: ставка принимается только если
  /// клиент прислал то же значение, которое видел — иначе двое, нажавших
  /// одновременно, получили бы одну и ту же сумму.
  currentBid        Int
  /// Момент окончания торгов. Null — без ограничения времени, торги идут,
  /// пока ГМ не завершит их вручную. Храним именно момент, а не остаток:
  /// остаток пришлось бы пересчитывать при каждом чтении, и у участников с
  /// разными часами он разъезжался бы.
  endsAt            DateTime?
  leaderPlayerId    String?
  leaderName        String?
  createdBy         String?
  createdAt         DateTime         @default(now())
  finishedAt        DateTime?
  /// Операция казны, которой завели выручку с этих торгов. Нужна, чтобы при
  /// удалении записи убрать и золото: без ссылки пришлось бы искать операцию
  /// по тексту описания, а это разъехалось бы при первом же переименовании.
  /// Null — торги без ставок (продавать было нечего) или запись старше этого поля.
  saleTransactionId String?
  bids              AuctionBid[]

  @@index([status])
}

/// Одна строка журнала торгов: ставка или пропуск.
model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  /// Ссылка на игрока снимается при его удалении, имя в журнале остаётся.
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  name      String
  amount    Int
  /// "bid" — ставка, "skip" — пропуск хода.
  kind      String   @default("bid")
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

/// Общие настройки приложения в виде ключ-значение.
/// Нужна ровно одна гарантия: значение, записанное однажды, не меняется при
/// повторном запуске или миграции. Поэтому запись создаётся только если её
/// ещё нет (см. src/lib/settings.ts).
model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
