// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("member")
  createdAt    DateTime @default(now())
  player       Player?
}

model Player {
  id            String                @id @default(cuid())
  name          String
  role          String
  level         Int                   @default(1)
  xp            Int                   @default(0)
  attendancePct Int                   @default(0)
  createdAt     DateTime              @default(now())
  activities    ActivityParticipant[]
  userId        String?               @unique
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments      Payment[]
  auctionLots   AuctionLot[]
}

model Activity {
  id           String                @id @default(cuid())
  name         String
  date         DateTime              @default(now())
  createdAt    DateTime              @default(now())
  participants ActivityParticipant[]
}

model ActivityParticipant {
  id         String   @id @default(cuid())
  activityId String
  playerId   String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([activityId, playerId])
}

model TreasuryTransaction {
  id          String   @id @default(cuid())
  description String
  amount      Int
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model GuildSettings {
  id                     Int       @id @default(1)
  raidDropGoldEquivalent Int       @default(0)
  nextPayoutDate         DateTime?
}

model Payment {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amount    Int
  status    String   @default("Ожидает")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model AuctionLot {
  id        String   @id @default(cuid())
  item      String
  sellerId  String
  seller    Player   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  price     Int
  endsAt    DateTime
  createdAt DateTime @default(now())
}

model Tournament {
  id        String    @id @default(cuid())
  name      String
  status    String    @default("Регистрация")
  teams     Int       @default(0)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
}
